# Local secrets for `wrangler dev`. Copy to `.dev.vars` and fill in.
# In production set each with: wrangler secret put <NAME>

# One-time first-admin bootstrap secret (minimum 32 random characters).
# Delete it from the remote environment immediately after bootstrap succeeds.
BOOTSTRAP_TOKEN=""

# Local email preview. Production uses EMAIL_DELIVERY_MODE=resend from
# wrangler.toml and requires these values via `wrangler secret put`.
EMAIL_DELIVERY_MODE="console"
RESEND_API_KEY=""
EMAIL_FROM="KeyForge <auth@pangda.app>"

# HMAC key for privacy-preserving request metadata hashes. Remote readiness
# requires at least 32 characters; configuring one locally keeps hashes stable.
REQUEST_HASH_SECRET=""

# Dedicated readiness bearer credential. Local readiness does not require it;
# set a different random 32+ character secret in dev and production.
READINESS_PROBE_TOKEN=""

# Development-only escape hatch. Honoured ONLY when ENVIRONMENT is exactly
# "dev" and the value is exactly "true"; local, test, and production ignore it.
# When on, KeyForge skips every substantive validation and approves any request.
# Never enable it against production data or for real users.
YOLO_MODE="false"
