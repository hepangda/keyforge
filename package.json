{
  "name": "keyforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20 <27",
    "pnpm": ">=10"
  },
  "type": "module",
  "description": "KeyForge - single-tenant OIDC/OAuth 2.1 authorization server on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "dev:yolo": "wrangler dev --var ENVIRONMENT:dev --var YOLO_MODE:true",
    "validate:deploy:dev": "node scripts/validate-deploy-config.mjs dev",
    "validate:deploy:production": "node scripts/validate-deploy-config.mjs production",
    "deploy": "pnpm validate:deploy:production && wrangler deploy --env production",
    "deploy:dev": "pnpm validate:deploy:dev && wrangler deploy --env dev",
    "deploy:production": "pnpm validate:deploy:production && wrangler deploy --env production",
    "deploy:dry-run:dev": "wrangler deploy --dry-run --env dev",
    "deploy:dry-run:production": "wrangler deploy --dry-run --env production",
    "release:dev": "node scripts/release.mjs dev",
    "release:production": "node scripts/release.mjs production",
    "release:prod": "node scripts/release.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=10000 --maxWorkers=50%",
    "test:watch": "vitest",
    "check": "biome check . && node --check scripts/release.mjs && tsc --noEmit && vitest run",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "demo:selftest": "pnpm --dir examples/demo-app install --frozen-lockfile && pnpm --dir examples/demo-app selftest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply keyforge --local",
    "db:migrate": "pnpm validate:deploy:production && wrangler d1 migrations apply keyforge --env production --remote",
    "db:migrate:dev": "pnpm validate:deploy:dev && wrangler d1 migrations apply keyforge_dev --env dev --remote",
    "db:migrate:production": "pnpm validate:deploy:production && wrangler d1 migrations apply keyforge --env production --remote"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "ulidx": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.17": "3.3.18",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    },
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ]
  }
}
